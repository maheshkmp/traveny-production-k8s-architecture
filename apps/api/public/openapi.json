                          "subscriptionId": {
                            "type": "string",
                            "nullable": true
                          },
                          "subscriptionStatus": {
                            "type": "string",
                            "nullable": true,
                            "enum": [
                              "active",
                              "cancelled",
                              "expired"
                            ]
                          },
                          "subscriptionCurrentPeriodEnd": {
                            "anyOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "string",
                                "format": "date"
