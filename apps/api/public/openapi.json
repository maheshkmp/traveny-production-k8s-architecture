    "/api": {
      "get": {
        "tags": [
          "Index"
        ],
        "responses": {
          "200": {
            "description": "Hono API - Index Endpoint",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "auth": {
                      "type": "object",
                      "properties": {
                        "user": {
                          "nullable": true
                        },
                        "session": {
                          "nullable": true
                        }
                      }
                    }
                  },
                  "required": [
                    "message",
                    "auth"
                  ]
                }
              }
            }
          }
        }
      }
    },
